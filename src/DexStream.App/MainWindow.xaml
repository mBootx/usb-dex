<Window x:Class="DexStream.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:DexStream.App.Views"
        Title="DexStream"
        Width="1440"
        Height="900"
        MinWidth="720"
        MinHeight="480"
        Background="{StaticResource ShellBackground}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

  <DockPanel>

    <!-- Toolbar: one-click start and stop, plus the device navigation shortcuts. -->
    <Border DockPanel.Dock="Top"
            Background="{StaticResource ShellPanel}"
            BorderBrush="{StaticResource ShellBorder}"
            BorderThickness="0,0,0,1"
            Padding="10,8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Horizontal">
          <Button Content="Start streaming"
                  Command="{Binding StartCommand}"
                  IsEnabled="{Binding CanStart}" />
          <Button Content="Stop"
                  Command="{Binding StopCommand}"
                  IsEnabled="{Binding CanStop}" />
          <Border Width="10" />
          <Button Content="Back" Command="{Binding BackCommand}" Padding="10,5" />
          <Button Content="Home" Command="{Binding HomeCommand}" Padding="10,5" />
          <Button Content="Recents" Command="{Binding RecentsCommand}" Padding="10,5" />
        </StackPanel>

        <StackPanel Grid.Column="1" Margin="18,0" VerticalAlignment="Center">
          <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsError}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource ShellError}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <TextBlock Text="{Binding DeviceText}" Style="{StaticResource MutedText}" />
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal">
          <Button x:Name="SettingsButton" Content="Settings" Click="OnSettingsClick" />
          <Button x:Name="DiagnosticsButton" Content="Diagnostics" Click="OnDiagnosticsClick" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Metrics bar. WPF cannot draw over the hosted swap chain, so the figures live below it rather
         than as an overlay. -->
    <Border DockPanel.Dock="Bottom"
            Background="{StaticResource ShellPanel}"
            BorderBrush="{StaticResource ShellBorder}"
            BorderThickness="0,1,0,0"
            Padding="10,6"
            Visibility="{Binding ShowMetricsBar, Converter={StaticResource BooleanToVisibility}}">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="Frame rate" Style="{StaticResource MetricLabel}" />
        <TextBlock Text="{Binding FrameRateText}" Style="{StaticResource MetricValue}" />
        <TextBlock Text="Bitrate" Style="{StaticResource MetricLabel}" />
        <TextBlock Text="{Binding BitrateText}" Style="{StaticResource MetricValue}" />
        <TextBlock Text="Latency" Style="{StaticResource MetricLabel}" />
        <TextBlock Text="{Binding LatencyText}" Style="{StaticResource MetricValue}" />
        <TextBlock Text="Control RTT" Style="{StaticResource MetricLabel}" />
        <TextBlock Text="{Binding RoundTripText}" Style="{StaticResource MetricValue}" />
        <TextBlock Text="{Binding FrameStatsText}" Style="{StaticResource MetricLabel}" />
        <TextBlock Text="{Binding CaptureText}" Style="{StaticResource MetricValue}" Margin="16,0,0,0" />
        <TextBlock Text="{Binding DecoderText}" Style="{StaticResource MetricLabel}" />
      </StackPanel>
    </Border>

    <!-- Diagnostics pane, collapsed by default. -->
    <Border x:Name="DiagnosticsPane"
            DockPanel.Dock="Bottom"
            Background="#FF15151A"
            BorderBrush="{StaticResource ShellBorder}"
            BorderThickness="0,1,0,0"
            Height="190"
            Visibility="Collapsed">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,6,8,4">
          <TextBlock Text="Diagnostics" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
          <Button Content="Copy" Command="{Binding CopyDiagnosticsCommand}" Padding="10,3" />
          <TextBlock x:Name="LogPathText" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
        </StackPanel>
        <ListBox ItemsSource="{Binding Log}"
                 Background="Transparent"
                 BorderThickness="0"
                 Foreground="{StaticResource ShellTextMuted}"
                 FontFamily="Consolas"
                 FontSize="11"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 VirtualizingPanel.IsVirtualizing="True" />
      </DockPanel>
    </Border>

    <!-- The stream itself. -->
    <Grid Background="Black">
      <views:StreamSurface x:Name="Surface" />

      <!-- Shown only before the first frame; the surface covers it once streaming starts. -->
      <StackPanel x:Name="Placeholder"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  IsHitTestVisible="False">
        <TextBlock Text="DexStream"
                   FontSize="26"
                   FontWeight="Light"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,8" />
        <TextBlock Text="{Binding StatusText}"
                   Style="{StaticResource MutedText}"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   MaxWidth="560"
                   TextWrapping="Wrap" />
        <TextBlock Text="{Binding StatusDetail}"
                   Style="{StaticResource MutedText}"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   MaxWidth="560"
                   Margin="0,8,0,0"
                   TextWrapping="Wrap" />
      </StackPanel>
    </Grid>

  </DockPanel>
</Window>
