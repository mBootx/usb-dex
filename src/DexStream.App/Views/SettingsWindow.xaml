<Window x:Class="DexStream.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DexStream settings"
        Width="520"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource ShellBackground}"
        ShowInTaskbar="False">

  <StackPanel Margin="18">

    <TextBlock Text="Stream quality" FontWeight="SemiBold" Margin="0,0,0,8" />

    <TextBlock Text="Resolution limit" Style="{StaticResource MutedText}" />
    <ComboBox x:Name="MaxSizeBox" SelectedIndex="0">
      <ComboBoxItem Content="Device maximum" Tag="0" />
      <ComboBoxItem Content="3840 px (4K)" Tag="3840" />
      <ComboBoxItem Content="2560 px (QHD)" Tag="2560" />
      <ComboBoxItem Content="1920 px (FHD)" Tag="1920" />
      <ComboBoxItem Content="1280 px (HD)" Tag="1280" />
    </ComboBox>

    <TextBlock Text="Refresh rate" Style="{StaticResource MutedText}" />
    <ComboBox x:Name="RefreshRateBox" SelectedIndex="0">
      <ComboBoxItem Content="Device maximum" Tag="0" />
      <ComboBoxItem Content="144 Hz" Tag="144" />
      <ComboBoxItem Content="120 Hz" Tag="120" />
      <ComboBoxItem Content="90 Hz" Tag="90" />
      <ComboBoxItem Content="60 Hz" Tag="60" />
    </ComboBox>

    <TextBlock Text="Video codec" Style="{StaticResource MutedText}" />
    <ComboBox x:Name="CodecBox" SelectedIndex="0">
      <ComboBoxItem Content="Automatic (HEVC above QHD, otherwise H.264)" Tag="Automatic" />
      <ComboBoxItem Content="H.264 — widest decoder support" Tag="H264" />
      <ComboBoxItem Content="H.265 / HEVC — about half the bitrate" Tag="H265" />
    </ComboBox>

    <TextBlock Text="Bitrate" Style="{StaticResource MutedText}" />
    <ComboBox x:Name="BitrateBox" SelectedIndex="0">
      <ComboBoxItem Content="Automatic (from resolution and refresh rate)" Tag="0" />
      <ComboBoxItem Content="60 Mbit/s" Tag="60000000" />
      <ComboBoxItem Content="40 Mbit/s" Tag="40000000" />
      <ComboBoxItem Content="25 Mbit/s" Tag="25000000" />
      <ComboBoxItem Content="12 Mbit/s" Tag="12000000" />
    </ComboBox>

    <TextBlock Text="Scaling" Style="{StaticResource MutedText}" />
    <ComboBox x:Name="ScalingBox" SelectedIndex="0">
      <ComboBoxItem Content="Fit — keep the aspect ratio" Tag="Fit" />
      <ComboBoxItem Content="Stretch — fill the window" Tag="Stretch" />
      <ComboBoxItem Content="Whole pixels — sharpest, keeps the aspect ratio" Tag="IntegerFit" />
    </ComboBox>

    <Border Height="1" Background="{StaticResource ShellBorder}" Margin="0,10,0,12" />

    <TextBlock Text="Behaviour" FontWeight="SemiBold" Margin="0,0,0,4" />

    <CheckBox x:Name="AutoStartBox" Content="Start streaming as soon as a device is connected" />
    <CheckBox x:Name="TurnScreenOffBox" Content="Turn the phone's screen off while streaming" />
    <CheckBox x:Name="RequireDexBox"
              Content="Only stream the DeX desktop, never mirror the phone screen" />
    <CheckBox x:Name="ActivateDexBox"
              Content="Create a desktop display on the device when DeX is not running" />
    <CheckBox x:Name="ReuseAdbKeyBox"
              Content="Reuse the existing ADB key so the phone does not ask again" />
    <CheckBox x:Name="AlwaysOnTopBox" Content="Keep the window on top" />
    <CheckBox x:Name="MetricsBarBox" Content="Show the metrics bar" />

    <TextBlock Style="{StaticResource MutedText}"
               Margin="0,10,0,0"
               TextWrapping="Wrap"
               Text="Quality settings take effect the next time streaming starts." />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Cancel" Click="OnCancelClick" Padding="16,5" />
      <Button Content="Save" Click="OnSaveClick" Padding="16,5" Margin="0" />
    </StackPanel>

  </StackPanel>
</Window>
