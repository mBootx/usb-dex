<Application x:Class="DexStream.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:System.Windows.Controls;assembly=PresentationFramework">
  <Application.Resources>

    <!-- Used to hide the metrics bar without collapsing the layout around it. -->
    <controls:BooleanToVisibilityConverter x:Key="BooleanToVisibility" />

    <!-- A dark shell keeps the eye on the streamed desktop rather than on the chrome around it. -->
    <SolidColorBrush x:Key="ShellBackground" Color="#FF1B1B1F" />
    <SolidColorBrush x:Key="ShellPanel" Color="#FF252529" />
    <SolidColorBrush x:Key="ShellBorder" Color="#FF3A3A40" />
    <SolidColorBrush x:Key="ShellText" Color="#FFE8E8EC" />
    <SolidColorBrush x:Key="ShellTextMuted" Color="#FF9A9AA5" />
    <SolidColorBrush x:Key="ShellAccent" Color="#FF4C8DFF" />
    <SolidColorBrush x:Key="ShellError" Color="#FFFF6B6B" />

    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource ShellText}" />
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <Style x:Key="MutedText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="Foreground" Value="{StaticResource ShellTextMuted}" />
    </Style>

    <Style x:Key="MetricLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="Foreground" Value="{StaticResource ShellTextMuted}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Margin" Value="0,0,4,0" />
    </Style>

    <Style x:Key="MetricValue" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontFamily" Value="Consolas" />
      <Setter Property="Margin" Value="0,0,16,0" />
    </Style>

    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource ShellText}" />
      <Setter Property="Background" Value="{StaticResource ShellPanel}" />
      <Setter Property="BorderBrush" Value="{StaticResource ShellBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="12,5" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Shell"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="4"
                    SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource ShellAccent}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
                <Setter Property="Cursor" Value="Arrow" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource ShellText}" />
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Margin" Value="0,4" />
    </Style>

    <Style TargetType="ComboBox">
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Margin" Value="0,2,0,8" />
      <Setter Property="Padding" Value="6,3" />
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Margin" Value="0,2,0,8" />
      <Setter Property="Padding" Value="6,3" />
    </Style>

  </Application.Resources>
</Application>
